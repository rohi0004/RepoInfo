# GitHub Token
GITHUB_TOKEN="your_github_token"

# Gemini API Key
GEMINI_API_KEY="your_gemini_api_key"

# DeepSeek API Key (optional)
DEEPSEEK_API_KEY="your_deepseek_api_key"

# App URL - IMPORTANT: Set to your production URL on Netlify
# Local: http://localhost:3000
# Production: https://repoinfo.netlify.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Configuration (Required for visitor tracking and billing)
# Get a free MongoDB Atlas cluster at https://cloud.mongodb.com
# For local development: mongodb://localhost:27017
# For Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="repoinfo"

# Stripe Configuration (Required for billing)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# Email Configuration (for receipts)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
# Optional:
# EMAIL_FROM="Your Name <your_email@gmail.com>"

# Caching - Vercel KV or Redis
KV_REST_API_READ_ONLY_TOKEN="your_kv_rest_api_read_only_token"
KV_REST_API_TOKEN="your_kv_rest_api_token"
KV_REST_API_URL="your_kv_rest_api_url"
KV_URL="your_kv_url"
# OR use Redis:
REDIS_URL="redis://localhost:6379"