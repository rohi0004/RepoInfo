FROM node:20-alpine AS builder

WORKDIR /app

# Install dev dependencies for build
COPY package*.json ./
RUN npm ci

# Copy source and build
COPY . .

# Force Webpack (disable Turbopack) during build
ENV NEXT_DISABLE_TURBOPACK=1
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app

# Runtime: install only production deps
COPY package*.json ./
# Use --omit=dev for newer npm, fallback to --only=production is OK
RUN npm ci --omit=dev || npm ci --only=production

# Copy built output and public assets
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public

# If you use a custom server, copy it as well
COPY --from=builder /app/server ./server

EXPOSE 3000
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

CMD ["npm", "start"]
